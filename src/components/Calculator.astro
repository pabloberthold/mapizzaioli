---
// src/components/Calculator.astro
// Calculadora interactiva: inputs → resultados → imprimir/guardar PDF.
// Interactividad con JS vanilla (sin framework) vía <script> de Astro.

import {
  computeDough,
  formatGrams,
  isValidDoughInputs,
  type DoughInputs,
} from "../lib/dough";

interface Props {
  title: string;
  description: string;
  defaults: DoughInputs;
  steps: string[];
}

const { title, description, defaults, steps } = Astro.props;

const result = computeDough(defaults);
const hasSteps = steps.length > 0;
---

<section class="calculator" aria-label="Calculadora de receta">
  <div class="recipe-sheet">
    <header class="recipe-sheet__head">
      <div class="print-only">
        <h1>{title}</h1>
        <p class="recipe-sheet__meta" data-print-meta>
          {formatGrams(defaults.flourGrams)} g de harina · {defaults.hydrationPercent}% hidratación · {defaults.fermentationHours} h · {defaults.fermentationTempC} °C
        </p>
      </div>

      <div class="calculator__intro">
        <h2 class="calculator__title">{title}</h2>
        <p class="calculator__description">{description}</p>
      </div>

      <form class="calculator__form screen-only" id="calc-form" autocomplete="off">
        <div class="field">
          <label for="inp-flour">Harina (g)</label>
          <input id="inp-flour" type="number" min="1" step="1" inputmode="decimal" value={defaults.flourGrams} />
        </div>
        <div class="field">
          <label for="inp-hydration">Hidratación (%)</label>
          <input id="inp-hydration" type="number" min="1" step="1" inputmode="decimal" value={defaults.hydrationPercent} />
        </div>
        <div class="field">
          <label for="inp-hours">Horas de fermentación</label>
          <input id="inp-hours" type="number" min="0.1" step="0.5" inputmode="decimal" value={defaults.fermentationHours} />
        </div>
        <div class="field">
          <label for="inp-temp">Temperatura (°C)</label>
          <input id="inp-temp" type="number" min="1" step="1" inputmode="decimal" value={defaults.fermentationTempC} />
        </div>
        <p class="calculator__error" id="calc-error" role="alert" hidden>
          Ingresá valores mayores a cero en todos los campos.
        </p>
      </form>
    </header>

    <div class="calculator__results">
      <h3 class="results__heading">Resultado</h3>
      <dl class="results-grid results-grid--main">
        <div class="result-card">
          <dt>Levadura fresca</dt>
          <dd><span id="res-fresh">{formatGrams(result.freshYeast, 2)}</span><span class="unit">g</span></dd>
        </div>
        <div class="result-card">
          <dt>Levadura seca</dt>
          <dd><span id="res-dry">{formatGrams(result.dryYeast, 2)}</span><span class="unit">g</span></dd>
        </div>
        <div class="result-card">
          <dt>Sal</dt>
          <dd><span id="res-salt">{formatGrams(result.salt)}</span><span class="unit">g</span></dd>
        </div>
        <div class="result-card">
          <dt>Agua</dt>
          <dd><span id="res-water">{formatGrams(result.water)}</span><span class="unit">g</span></dd>
        </div>
      </dl>

      <div class="results-split">
        <div class="results-block">
          <h4 class="results-block__title">Biga <span class="results-block__sub">24 horas</span></h4>
          <dl class="results-list">
            <div><dt>Harina</dt><dd><span id="res-biga-flour">{formatGrams(result.biga.flour)}</span> g</dd></div>
            <div><dt>Agua</dt><dd><span id="res-biga-water">{formatGrams(result.biga.water)}</span> g</dd></div>
            <div><dt>Levadura fresca</dt><dd><span id="res-biga-fresh">{formatGrams(result.biga.freshYeast, 2)}</span> g</dd></div>
            <div><dt>Levadura seca</dt><dd><span id="res-biga-dry">{formatGrams(result.biga.dryYeast, 2)}</span> g</dd></div>
          </dl>
        </div>

        <div class="results-block">
          <h4 class="results-block__title">Después de 24 horas</h4>
          <dl class="results-list">
            <div><dt>Harina</dt><dd><span id="res-rest-flour">{formatGrams(result.rest.flour)}</span> g</dd></div>
            <div><dt>Agua</dt><dd><span id="res-rest-water">{formatGrams(result.rest.water)}</span> g</dd></div>
            <div><dt>Sal</dt><dd><span id="res-rest-salt">{formatGrams(result.rest.salt)}</span> g</dd></div>
            <div><dt>Aceite</dt><dd><span id="res-rest-oil">{formatGrams(result.rest.oil)}</span> g</dd></div>
          </dl>
        </div>
      </div>

      <p class="results-total">
        Masa total: <strong><span id="res-total">{formatGrams(result.total)}</span> g</strong>
      </p>
    </div>

    {
      hasSteps && (
        <section class="recipe-steps" aria-label="Proceso">
          <h3 class="results__heading">Proceso</h3>
          <ol class="steps">
            {steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      )
    }

    <div class="calculator__actions screen-only">
      <button type="button" class="btn btn--primary" id="btn-print">
        Imprimir / Guardar PDF
      </button>
    </div>
  </div>
</section>

<script>
  import { computeDough, formatGrams, isValidDoughInputs } from "../lib/dough";

  const ids = {
    flour: "inp-flour",
    hydration: "inp-hydration",
    hours: "inp-hours",
    temp: "inp-temp",
  };

  const out = {
    fresh: "res-fresh",
    dry: "res-dry",
    salt: "res-salt",
    water: "res-water",
    bigaFlour: "res-biga-flour",
    bigaWater: "res-biga-water",
    bigaFresh: "res-biga-fresh",
    bigaDry: "res-biga-dry",
    restFlour: "res-rest-flour",
    restWater: "res-rest-water",
    restSalt: "res-rest-salt",
    restOil: "res-rest-oil",
    total: "res-total",
  };

  const el = (id: string) => document.getElementById(id) as HTMLElement | null;
  const num = (id: string) => {
    const node = el(id) as HTMLInputElement | null;
    return node ? Number(node.value) : 0;
  };

  function set(id: string, text: string) {
    const node = el(id);
    if (node) node.textContent = text;
  }

  function update() {
    const inputs = {
      flourGrams: num(ids.flour),
      hydrationPercent: num(ids.hydration),
      fermentationHours: num(ids.hours),
      fermentationTempC: num(ids.temp),
    };

    const error = el("calc-error");
    if (!isValidDoughInputs(inputs)) {
      if (error) error.hidden = false;
      return;
    }
    if (error) error.hidden = true;

    const r = computeDough(inputs);

    set(out.fresh, formatGrams(r.freshYeast, 2));
    set(out.dry, formatGrams(r.dryYeast, 2));
    set(out.salt, formatGrams(r.salt));
    set(out.water, formatGrams(r.water));
    set(out.bigaFlour, formatGrams(r.biga.flour));
    set(out.bigaWater, formatGrams(r.biga.water));
    set(out.bigaFresh, formatGrams(r.biga.freshYeast, 2));
    set(out.bigaDry, formatGrams(r.biga.dryYeast, 2));
    set(out.restFlour, formatGrams(r.rest.flour));
    set(out.restWater, formatGrams(r.rest.water));
    set(out.restSalt, formatGrams(r.rest.salt));
    set(out.restOil, formatGrams(r.rest.oil));
    set(out.total, formatGrams(r.total));

    const meta = el("print-meta") as HTMLElement | null;
    if (meta) {
      meta.textContent =
        `${formatGrams(inputs.flourGrams)} g de harina · ` +
        `${inputs.hydrationPercent}% hidratación · ` +
        `${inputs.fermentationHours} h · ${inputs.fermentationTempC} °C`;
    }
  }

  Object.values(ids).forEach((id) => {
    const node = el(id);
    node?.addEventListener("input", update);
  });

  el("btn-print")?.addEventListener("click", () => window.print());
</script>

<style>
  .calculator {
    max-width: 860px;
    margin-inline: auto;
  }

  .recipe-sheet {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(31, 27, 22, 0.06), 0 12px 32px -16px rgba(31, 27, 22, 0.18);
  }

  .recipe-sheet__head {
    padding: var(--spacing-xl);
    border-bottom: 1px solid var(--color-border-default);
  }

  .calculator__intro {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }
  .calculator__title {
    font-size: var(--font-size-heading-md);
    margin-bottom: var(--spacing-sm);
  }
  .calculator__description {
    color: var(--color-text-secondary);
    margin: 0 auto;
    max-width: 46ch;
  }

  .calculator__form {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }
  @media (max-width: 640px) {
    .calculator__form {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .field label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }
  .field input {
    font: inherit;
    color: var(--color-text-primary);
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input:focus {
    outline: none;
    border-color: var(--color-focus-ring);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-focus-ring) 22%, transparent);
  }

  .calculator__error {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-state-error);
    font-size: var(--font-size-sm);
  }

  .calculator__results {
    padding: var(--spacing-xl);
  }

  .results__heading {
    font-size: var(--font-size-heading-sm);
    margin-bottom: var(--spacing-md);
  }

  .results-grid {
    display: grid;
    gap: var(--spacing-md);
    margin: 0 0 var(--spacing-xl);
  }
  .results-grid--main {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 640px) {
    .results-grid--main {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .result-card {
    background: var(--color-surface-highlight);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
  }
  .result-card dt {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
  }
  .result-card dd {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .result-card .unit {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    margin-left: 2px;
  }

  .results-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }
  @media (max-width: 640px) {
    .results-split {
      grid-template-columns: 1fr;
    }
  }

  .results-block {
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }
  .results-block__title {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-md);
  }
  .results-block__sub {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .results-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .results-list > div {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    font-size: var(--font-size-md);
  }
  .results-list dt {
    color: var(--color-text-secondary);
  }
  .results-list dd {
    margin: 0;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .results-total {
    text-align: right;
    font-size: var(--font-size-lg);
    margin: 0;
  }
  .results-total strong {
    color: var(--color-brand-primary);
  }

  .recipe-steps {
    padding: 0 var(--spacing-xl) var(--spacing-xl);
  }
  .steps {
    margin: 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    color: var(--color-text-secondary);
  }
  .steps li {
    padding-left: var(--spacing-xs);
  }

  .calculator__actions {
    display: flex;
    justify-content: center;
    padding: 0 var(--spacing-xl) var(--spacing-xl);
  }

  .btn {
    font: inherit;
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    border-radius: var(--radius-full);
    padding: var(--spacing-md) var(--spacing-xl);
    border: 1px solid transparent;
    transition: background-color 0.15s ease, transform 0.05s ease;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--primary {
    background: var(--color-brand-primary);
    color: var(--color-text-inverse);
  }
  .btn--primary:hover {
    background: var(--color-brand-primary-hover);
  }

  .print-only {
    display: none;
  }

  /* Impresión: ocultar controles, mostrar hoja de receta limpia */
  @media print {
    .recipe-sheet {
      box-shadow: none;
      border: none;
      border-radius: 0;
    }
    .screen-only {
      display: none !important;
    }
    .print-only {
      display: block;
      margin-bottom: var(--spacing-lg);
    }
    .print-only h1 {
      font-size: var(--font-size-heading-md);
      margin-bottom: var(--spacing-xs);
    }
    .recipe-sheet__meta {
      color: var(--color-text-secondary);
      font-size: var(--font-size-sm);
    }
    .calculator__results {
      padding: 0;
    }
    .result-card {
      border: 1px solid var(--color-border-default);
      background: none;
    }
    .recipe-steps {
      padding: var(--spacing-xl) 0 0;
    }
  }
</style>
