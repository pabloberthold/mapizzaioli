---
// src/pages/recetas/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Calculator from "../../components/Calculator.astro";
import ExpressCalculator from "../../components/ExpressCalculator.astro";
import StaticRecipe from "../../components/StaticRecipe.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { recipeJsonLd } from "../../lib/seo";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"recipes">;
}

const { entry } = Astro.props;
const { title, description, steps, calculator, ingredients, note, image } = entry.data;

const base = import.meta.env.BASE_URL;
const ld = recipeJsonLd(entry);
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(base, Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Recetas", item: new URL(`${base}recetas/`, Astro.site).href },
    { "@type": "ListItem", position: 3, name: title },
  ],
};
---

<Layout title={`${title} — mapizzaioli`} description={description}>
  <main>
    <section class="recipe-page">
      <div class="container">
        <nav class="breadcrumb" aria-label="Miga de pan">
          <a href={`${base}recetas/`}>Recetas</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        {
          calculator ? (
            calculator.engine === "express" ? (
              <ExpressCalculator
                title={title}
                description={description}
                defaults={{
                  flourGrams: calculator.flourGrams,
                  restMinutes: calculator.restMinutes,
                }}
                steps={steps}
                image={image}
              />
            ) : (
              <Calculator
                title={title}
                description={description}
                defaults={{
                  flourGrams: calculator.flourGrams,
                  hydrationPercent: calculator.hydrationPercent,
                  fermentationHours: calculator.fermentationHours,
                  fermentationTempC: calculator.fermentationTempC,
                }}
                steps={steps}
                image={image}
              />
            )
          ) : (
            <StaticRecipe
              title={title}
              description={description}
              ingredients={ingredients ?? []}
              steps={steps}
              note={note}
              image={image}
            />
          )
        }
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>

<style>
  .recipe-page {
    padding-block: var(--spacing-xl) var(--spacing-3xl);
  }
  .breadcrumb {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }
  .breadcrumb a {
    color: var(--color-brand-primary);
  }
</style>
