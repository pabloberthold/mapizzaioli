---
// src/pages/recetas/index.astro
import Layout from "../../layouts/Layout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes")).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL;

const CATEGORY_LABELS: Record<string, string> = {
  italiana: "Recetas italianas",
  alemana: "Recetas alemanas",
  otras: "Otras recetas",
};

const CATEGORY_ORDER = ["italiana", "alemana", "otras"];

const groups = new Map<string, typeof recipes>();
for (const entry of recipes) {
  const cat = entry.data.category;
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(entry);
}
---

<Layout
  title="Recetas — mapizzaioli"
  description="Recetas de mapizzaioli organizadas por capítulo: masas italianas, recetas alemanas y otras recetas."
>
  <main>
    <section class="page-head">
      <div class="container">
        <h1 class="page-head__title">Recetas</h1>
        <p class="page-head__subtitle">
          Recetas de masa con calculadora y recetas clásicas alemanas e italianas, por capítulo.
        </p>
      </div>
    </section>

    {
      CATEGORY_ORDER.map((cat) => {
        const items = groups.get(cat);
        if (!items || items.length === 0) return null;
        return (
          <section class="container category">
            <h2 class="category__title">{CATEGORY_LABELS[cat]}</h2>
            <ul class="recipe-grid">
              {items.map((entry) => (
                <li>
                  <RecipeCard
                    href={`${base}recetas/${entry.slug}/`}
                    entry={entry}
                  />
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </main>
</Layout>

<style>
  .page-head {
    padding-block: var(--spacing-2xl);
  }
  .page-head__title {
    font-size: var(--font-size-heading-md);
    margin-bottom: var(--spacing-sm);
  }
  .page-head__subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .category {
    margin-bottom: var(--spacing-3xl);
  }
  .category__title {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    font-size: var(--font-size-heading-sm);
    margin-bottom: var(--spacing-lg);
  }
  .category__title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border-default);
  }

  .recipe-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--grid-gap);
  }
</style>