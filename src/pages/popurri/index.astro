---
// src/pages/popurri/index.astro
import Layout from "../../layouts/Layout.astro";
import { POPURRI_CATEGORIES } from "../../data/popurri/manifest";
import "../../styles/popurri.css";

const base = import.meta.env.BASE_URL;
const TOTAL = POPURRI_CATEGORIES.reduce((acc, c) => acc + c.count, 0);
const CATALOG = POPURRI_CATEGORIES.map((c) => ({ id: c.id, url: c.url }));
---

<Layout
  title="Popurrí — mapizzaioli"
  description={`Explorá las ${TOTAL} recetas de Popurrí (Cocineros Argentinos) organizadas en ${POPURRI_CATEGORIES.length} categorías, con buscador.`}
>
  <main>
    <script type="application/json" id="popurri-catalog" set:html={JSON.stringify(CATALOG)} />
    <section class="container popurri-head texture-flour">
      <h1 class="popurri-head__title">Popurrí</h1>
      <p class="popurri-head__subtitle">
        {TOTAL.toLocaleString("es-AR")} recetas de Cocineros Argentinos,
        recopiladas y clasificadas en {POPURRI_CATEGORIES.length} categorías.
        Buscá por nombre o ingrediente y hacé clic en un resultado para abrir la receta.
      </p>

      <div class="popurri-search">
        <span class="popurri-search__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.7" y2="16.7" />
          </svg>
        </span>
        <input
          id="popurri-global-search"
          class="popurri-search__input"
          type="search"
          placeholder={`Buscar en ${TOTAL.toLocaleString("es-AR")} recetas…`}
          autocomplete="off"
          aria-label="Buscar recetas en Popurrí"
        />
        <p id="popurri-global-count" class="popurri-search__count" aria-live="polite"></p>
      </div>
    </section>

    <section class="container popurri-global" id="popurri-global-results-wrap" hidden>
      <ul class="popurri-global-results" id="popurri-global-results"></ul>
      <p class="popurri-empty" id="popurri-global-empty" hidden>Sin resultados. Probá con otro término.</p>
    </section>

    <section class="container">
      <h2 class="popurri-section">Categorías</h2>
      <ul class="popurri-grid">
        {POPURRI_CATEGORIES.map((c) => (
          <li>
            <a href={`${base}popurri/${c.id}/`}>
              <p class="popurri-grid__name">{c.name}</p>
              <p class="popurri-grid__count">
                {c.count.toLocaleString("es-AR")} {c.count === 1 ? "receta" : "recetas"}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .popurri-global {
    padding-bottom: var(--spacing-2xl);
  }
  .popurri-section {
    font-size: var(--font-size-heading-sm);
    margin-bottom: var(--spacing-lg);
  }
  .popurri-section::after {
    content: "";
    display: block;
    height: 1px;
    background: var(--color-border-default);
    margin-top: var(--spacing-sm);
  }
</style>

<script>
  import { normalize, esc, renderRecipeText } from "../../lib/popurri";
  import DATA_URL from "../../data/popurri/index.json?url";

  const CATALOG = JSON.parse(document.getElementById("popurri-catalog").textContent);

  const input = document.getElementById("popurri-global-search");
  const wrap = document.getElementById("popurri-global-results-wrap");
  const listEl = document.getElementById("popurri-global-results");
  const emptyEl = document.getElementById("popurri-global-empty");
  const countEl = document.getElementById("popurri-global-count");

  let index = null;
  const cache = new Map();

  async function loadIndex() {
    if (index) return index;
    try {
      const res = await fetch(DATA_URL);
      if (!res.ok) throw new Error(String(res.status));
      index = await res.json();
    } catch {
      countEl.textContent = "Error al cargar índice.";
      return [];
    }
    return index;
  }

  async function loadRecipes(catId) {
    if (cache.has(catId)) return cache.get(catId);
    const cat = CATALOG.find((c) => c.id === catId);
    if (!cat) return [];
    try {
      const res = await fetch(cat.url);
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      cache.set(catId, data);
      return data;
    } catch {
      return [];
    }
  }

  function debounce(fn, ms) {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), ms);
    };
  }

  async function openRecipe(catId, i) {
    const recipes = await loadRecipes(catId);
    const r = recipes[i];
    if (r) showModal(catId, r);
  }

  function showModal(catId, r) {
    const base = import.meta.env.BASE_URL;
    const catName = CATALOG.find((c) => c.id === catId)?.name ?? "";
    const prevActive = document.activeElement;

    const modal = document.createElement("div");
    modal.className = "popurri-modal";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    modal.setAttribute("aria-labelledby", "popurri-modal-title");
    modal.innerHTML = `
      <div class="popurri-modal__backdrop" data-popurri-close></div>
      <div class="popurri-modal__panel">
        <header class="popurri-modal__head">
          <div class="popurri-modal__titles">
            <p class="popurri-modal__cat">${esc(catName)}</p>
            <h2 id="popurri-modal-title" class="popurri-modal__title">${esc(r.title)}</h2>
          </div>
          <button class="popurri-modal__close" data-popurri-close aria-label="Cerrar">×</button>
        </header>
        <div class="popurri-modal__body">
          ${renderRecipeText(r)}
          <p class="popurri-modal__links">
            <a class="popurri-ext" href="${base}popurri/${catId}/?open=${r.i}">Ver dentro de la categoría →</a>
            <a class="popurri-ext" href="${esc(r.url)}" target="_blank" rel="noopener">Ver en Cocineros Argentinos ↗</a>
          </p>
        </div>
      </div>
    `;

    const close = () => {
      document.removeEventListener("keydown", onKey);
      modal.remove();
      document.body.style.overflow = "";
      prevActive?.focus?.();
    };
    const onKey = (e) => {
      if (e.key === "Escape") close();
      if (e.key === "Tab") {
        const focusable = modal.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])');
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    modal.querySelectorAll("[data-popurri-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    document.addEventListener("keydown", onKey);
    document.body.appendChild(modal);
    document.body.style.overflow = "hidden";
    modal.querySelector(".popurri-modal__close")?.focus();
  }

  input.addEventListener(
    "input",
    debounce(async () => {
      const q = normalize(input.value.trim());
      if (!q) {
        wrap.hidden = true;
        countEl.textContent = "";
        listEl.replaceChildren();
        return;
      }
      const idx = await loadIndex();
      if (normalize(input.value.trim()) !== q) return;
      const results = idx.filter((e) => normalize(e.t).includes(q)).slice(0, 25);
      listEl.replaceChildren();
      emptyEl.hidden = results.length > 0;
      countEl.textContent = `${results.length} ${results.length === 1 ? "resultado" : "resultados"}`;
      for (const r of results) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "popurri-global-results__item";
        btn.innerHTML = `<span class="popurri-global-results__title">${esc(r.t)}</span><span class="popurri-global-results__cat">${esc(r.c)}</span>`;
        btn.addEventListener("click", () => openRecipe(r.c, r.i));
        li.appendChild(btn);
        listEl.appendChild(li);
      }
      wrap.hidden = false;
    }, 150),
  );
</script>