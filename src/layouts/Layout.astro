---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL("og-default.png", Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3232a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mapizzaioli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600;1,9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body style={`--bg-url: url(${base}fondo1.jpeg)`}>
    <div class="tricolor" aria-hidden="true">
      <span class="tricolor__green"></span>
      <span class="tricolor__red"></span>
      <span class="tricolor__gold"></span>
    </div>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={base} aria-label="mapizzaioli — inicio">
          <svg class="brand__seal" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
            <circle class="seal-base" cx="48" cy="48" r="47" />
            <circle class="seal-ring" cx="48" cy="48" r="42.5" />
            <circle class="seal-ring seal-ring--inner" cx="48" cy="48" r="38" />
            <path class="seal-flame" d="M48 14 C44 18 44 21 48 23 C52 21 52 18 48 14 Z" />
            <text class="seal-letter" style="font-family: var(--font-family-heading); font-style: italic; font-weight: 700;" x="48" y="64" text-anchor="middle">m</text>
            <defs>
              <path id="seal-top-arc" d="M 27 48 A 40 40 0 0 0 69 48" />
            </defs>
            <text class="seal-label">
              <textPath href="#seal-top-arc" startOffset="50%" text-anchor="middle">mapizzaioli · pizzeria</textPath>
            </text>
          </svg>
          <span class="brand__name">mapizzaioli</span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href={base} class:list={["site-nav__link", { "site-nav__link--active": Astro.url.pathname === base || Astro.url.pathname === "/" }]}>
            Inicio
          </a>
          <a href={`${base}recetas/`} class:list={["site-nav__link", { "site-nav__link--active": Astro.url.pathname.startsWith(`${base}recetas`) }]}>
            Recetas
          </a>
          <a href={`${base}popurri/`} class:list={["site-nav__link", { "site-nav__link--active": Astro.url.pathname.startsWith(`${base}popurri`) }]}>
            Popurrí
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>mapizzaioli — calculadora de masa para pizza.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .tricolor {
    display: flex;
    height: 4px;
  }
  .tricolor span {
    flex: 1;
  }
  .tricolor__green {
    background: var(--color-flag-italy-green);
  }
  .tricolor__red {
    background: var(--color-flag-italy-red);
  }
  .tricolor__gold {
    background: var(--color-flag-germany-gold);
  }

  .site-header {
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border-default);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
    padding-block: var(--spacing-md);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--color-text-primary);
  }
  .brand__seal {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: block;
  }
  .brand__seal .seal-base {
    fill: var(--color-brand-primary);
  }
  .brand__seal .seal-ring {
    fill: none;
    stroke: var(--color-flag-germany-gold);
    stroke-width: 1.4;
    opacity: 0.95;
  }
  .brand__seal .seal-ring--inner {
    stroke-width: 0.8;
    opacity: 0.55;
  }
  .brand__seal .seal-flame {
    fill: var(--color-flag-germany-gold);
    opacity: 0.9;
  }
  .brand__seal .seal-letter {
    fill: #ffffff;
    font-size: 36px;
  }
  .brand__seal .seal-label {
    fill: #ffffff;
    font-family: var(--font-family-base);
    font-size: 6.4px;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.18em;
  }
  .brand__name {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
  }

  .site-nav {
    display: flex;
    gap: var(--spacing-lg);
  }
  .site-nav__link {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    padding: var(--spacing-xs) 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav__link:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .site-nav__link--active {
    color: var(--color-brand-primary);
    border-bottom-color: var(--color-brand-primary);
  }

  .site-footer {
    margin-top: var(--spacing-3xl);
    padding-block: var(--spacing-xl);
    border-top: 1px solid var(--color-border-default);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .site-footer__inner p {
    margin: 0;
  }
</style>
